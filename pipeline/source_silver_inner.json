{
	"name": "source_silver_inner",
	"properties": {
		"activities": [
			{
				"name": "fetch tables deatils",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id=@{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_sqldb",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Set start time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "set_time",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-mm-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "copy data from source to landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "fetch tables deatils",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set start time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "SELECT * FROM PUBLIC.@{activity('fetch tables deatils').output.firstRow.source_table_name};",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_postgre",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_adlsgen2",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(\n    activity('fetch tables deatils').output.firstRow.source_system,\n    '/',\n    activity('fetch tables deatils').output.firstRow.source_table_name,\n    '/',\n    variables('set_time'))",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			}
		},
		"variables": {
			"set_time": {
				"type": "String"
			}
		},
		"annotations": []
	}
}