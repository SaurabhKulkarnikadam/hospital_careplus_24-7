{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "careplusadffactory"
		},
		"LS_ADLSgen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLSgen2'"
		},
		"LS_PostgreSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSql'"
		},
		"LS_sqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_sqldb'"
		},
		"LS_ADLSgen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://careplusstorageaccount.dfs.core.windows.net/"
		},
		"LS_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-curly-sound-aocyxrqu-pooler.c-2.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_azureKeyValut_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://carepluskelvault.vault.azure.net/"
		},
		"LS_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "careplus.database.windows.net"
		},
		"LS_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "care_plus_hospital"
		},
		"LS_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "careplus"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "careplusadffactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSgen2_accountKey": {
						"value": "[parameters('LS_ADLSgen2_accountKey')]"
					},
					"LS_PostgreSql_password": {
						"value": "[parameters('LS_PostgreSql_password')]"
					},
					"LS_sqldb_password": {
						"value": "[parameters('LS_sqldb_password')]"
					},
					"LS_ADLSgen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSgen2_properties_typeProperties_url')]"
					},
					"LS_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_server')]"
					},
					"LS_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_database')]"
					},
					"LS_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql_properties_typeProperties_username')]"
					},
					"LS_azureKeyValut_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_azureKeyValut_properties_typeProperties_baseUrl')]"
					},
					"LS_sqldb_properties_typeProperties_server": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_server')]"
					},
					"LS_sqldb_properties_typeProperties_database": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_database')]"
					},
					"LS_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('LS_sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}